# Local persistent SQLite database (created after running prisma migrate)
DATABASE_URL="file:../dev.db"

# Required in production: generate with `openssl rand -base64 48`
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
OTP_HASH_SECRET="replace-with-a-different-random-secret-at-least-32-characters-long"

# Local testing only: enables a visible development OTP (123456 for SMS; generated for email)
# NEVER enable this in production.
LIFELINK_DEV_OTP="true"

# Email OTP through Resend (required for real email delivery)
RESEND_API_KEY=""
RESEND_FROM="LifeLink <verification@your-domain.example>"

# SMS OTP through Twilio Verify (required for real SMS delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Set a real maintainer contact before using OpenStreetMap services in deployment
LIFELINK_OSM_USER_AGENT="LifeLink/1.3 (maintainer: your-email@example.com)"
